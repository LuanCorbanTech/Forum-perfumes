# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usada apenas em Server Actions/rotas administrativas server-side.
# NUNCA exponha esta chave no client. Painel > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública do site (usada nos redirects de auth por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
